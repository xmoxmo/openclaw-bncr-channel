{
  "name": "@xmoxmo/bncr",
  "version": "0.3.8",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmoxmo/openclaw-bncr-channel.git"
  },
  "homepage": "https://github.com/xmoxmo/openclaw-bncr-channel#readme",
  "bugs": {
    "url": "https://github.com/xmoxmo/openclaw-bncr-channel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "src/**/*.ts",
    "scripts/**/*.mjs",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "npx -y esbuild@0.28.0 index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "selfcheck": "node ./scripts/selfcheck.mjs",
    "test": "node --import ./tests/register-ts-hooks.mjs --test ./tests/**/*.test.mjs",
    "check-register-drift": "node ./scripts/check-register-drift.mjs",
    "check-pack": "node ./scripts/check-pack.mjs",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.typecheck.json",
    "fullcheck": "npm run typecheck && npm run check && npm test && npm run selfcheck && npm run check-pack && npm run format:check",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.0",
    "openclaw": ">=2026.5.27",
    "typescript": "^6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.5.27",
      "minGatewayVersion": "2026.5.27"
    },
    "build": {
      "openclawVersion": "2026.5.28",
      "pluginSdkVersion": "2026.5.28"
    },
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  }
}
